{
  "name": "mymovie-studio",
  "private": true,
  "version": "0.1.22",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/schema"
  ],
  "scripts": {
    "dev": "bun run --filter @mymovie/desktop dev",
    "build": "bun run --filter @mymovie/desktop build",
    "typecheck": "bun run --filter @mymovie/desktop typecheck",
    "lint": "bun run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "cd apps/desktop && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "vitest": "^5.0.4",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.2"
  }
}
