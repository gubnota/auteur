{
  "productName": "MyMovie Studio",
  "version": "0.1.12",
  "identifier": "net.fenki.mymovie-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyMovie Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 960,
        "minHeight": 650,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' mymovie: http://mymovie.localhost data:; media-src 'self' mymovie: http://mymovie.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["mymovie"],
        "name": "MyMovie document",
        "description": "Portable movie studio document",
        "role": "Editor",
        "mimeType": "application/x-mymovie"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
